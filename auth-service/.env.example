# =================================
# JWT (auth-service specific)
# =================================

# Generate with: openssl rand -base64 32
JWT_EMAIL_SECRET=vP3fVuuH9IfYVca/QzIsnraj5EkA/iH/7bvL23+YJCs=
JWT_PASSWORD_RESET_SECRET=vP3fVuuH9IfYVca/QzIsnraj5EkA/iH/7bvL23+YJCs=

# =================================
# PUBLIC URL
# =================================

# Must match your ngrok domain (or public URL) for OAuth callbacks
# Example: https://your-domain.ngrok-free.app
PUBLIC_URL=https://your-ngrok-domain.ngrok-free.app

# =================================
# EMAIL / SMTP
# =================================

# Gmail: enable App Passwords at https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# =================================
# GOOGLE OAUTH
# =================================

# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=