# =================================
# JWT (auth-service specific)
# =================================
# Generate with: openssl rand -base64 32
JWT_EMAIL_SECRET=replace_with_random_32+_char_secret
JWT_PASSWORD_RESET_SECRET=replace_with_random_32+_char_secret

# =================================
# PUBLIC URL
# =================================
# Must match your ngrok domain (or public URL) for OAuth callbacks
# Example: https://your-domain.ngrok-free.app
PUBLIC_URL=https://your-ngrok-domain.ngrok-free.app

# =================================
# EMAIL / SMTP
# =================================
# Gmail: enable App Passwords at https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# =================================
# GOOGLE OAUTH
# =================================
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=