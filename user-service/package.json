		"@nestjs/terminus": "^11.0.0",
		"@prisma/client": "^6.5.0",
		"@transcendence/types": "file:../shared/types",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.3",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@types/express": "^5.0.0",
		"@types/node": "^22.19.7",
		"eslint": "^9.18.0",
