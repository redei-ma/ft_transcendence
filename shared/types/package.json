{
	"name": "@transcendence/types",
	"version": "1.0.0",
	"private": true,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/esm/index.js",
			"require": "./dist/index.js"
		}
	},
	"scripts": {
		"generate": "ts-node --skip-project --compiler-options '{\"module\":\"CommonJS\"}' generate-enums.ts",
		"build": "npm run generate && tsc && tsc -p tsconfig.esm.json"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"ts-node": "^10.9.0",
		"typescript": "^5.9.3"
	}
}
