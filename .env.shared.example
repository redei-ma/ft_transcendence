# =================================
# DATABASE
# =================================

POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=transcendence_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# =================================
# JWT
# =================================

# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=replace_with_random_32+_char_secret
JWT_REFRESH_SECRET=replace_with_random_32+_char_secret

# =================================
# NGROK
# =================================

# Get your token at: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Your static ngrok domain (or leave empty to use a random one)
NGROK_DOMAIN=

# =================================
# REDIS
# =================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# =================================
# INTERNAL SERVICE SECRET
# Shared between services to authenticate internal endpoint calls.
# Generate with: openssl rand -base64 32
# =================================

INTERNAL_SERVICE_SECRET=replace_with_random_32+_char_secret

# =================================
# APP
# =================================
# NODE_ENV is set via docker-compose.yml (production) and
# docker-compose.override.yml (development). Do not set it here.

# Public URL of the frontend as seen by the browser (used for CORS).
# Must match the gateway URL.
FRONTEND_URL=https://localhost:2443

# =================================
# EMAIL
# =================================

# Gmail: enable App Passwords at https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# =================================
# SERVICE PORTS
# =================================

AUTH_SERVICE_PORT=3002
USER_SERVICE_PORT=3001
GAME_SERVICE_PORT=3000
MATCHMAKING_SERVICE_PORT=3500
