# =================================
# DATABASE
# =================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=transcendence_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# =================================
# JWT
# =================================
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=replace_with_random_32+_char_secret
JWT_REFRESH_SECRET=replace_with_random_32+_char_secret

# =================================
# NGROK (optional — needed for OAuth callbacks outside localhost)
# =================================
# Get your token at: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Your static ngrok domain (or leave empty to use a random one)
NGROK_DOMAIN=

# =================================
# APP
# =================================
NODE_ENV=development